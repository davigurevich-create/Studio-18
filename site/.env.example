VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# Public Key do Mercado Pago (Suas integracoes > aplicacao > Credenciais).
# Comeca com TEST- em modo teste e APP_USR- em producao. Esta chave e publica
# e pode ficar exposta no navegador — o Access Token (secreto) fica so na
# Supabase Edge Function mp-create-payment, nunca aqui.
VITE_MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Site Key do Cloudflare Turnstile (dashboard.cloudflare.com > Turnstile).
# Publica, pode ficar exposta no navegador — a Secret Key fica só nas
# Supabase Edge Functions mp-create-payment e site-chat (TURNSTILE_SECRET_KEY).
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
