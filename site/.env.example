VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# Site Key do Cloudflare Turnstile (dashboard.cloudflare.com > Turnstile).
# Publica, pode ficar exposta no navegador — a Secret Key fica só nas
# Supabase Edge Functions rede-create-payment e site-chat (TURNSTILE_SECRET_KEY).
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx

# ID do Meta Pixel (business.facebook.com > Gerenciador de Eventos > sua
# fonte de dados > detalhes > ID do Pixel). Pública, pode ficar exposta no
# navegador. Sem essa variável o pixel não carrega e todo trackEvent()
# vira no-op — o site funciona normalmente sem ela.
VITE_META_PIXEL_ID=
